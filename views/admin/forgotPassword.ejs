<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Forgot Password</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/x-icon" href="/logo.png">
</head>
<body>
  <main class="auth-page">
    <div class="auth-card">
      <div class="auth-brand">
        <a href="/"><img src="/logo.png" alt="Logo"></a>
        <h1>Forgot password?</h1>
        <p>Enter your email and we'll send you a link to reset it.</p>
      </div>

      <% if (message) { %>
        <% const isError = /not exist/i.test(message); %>
        <div class="auth-alert <%= isError ? 'auth-alert--error' : 'auth-alert--success' %>" role="status">
          <i class="fa-solid <%= isError ? 'fa-circle-exclamation' : 'fa-circle-check' %>"></i>
          <span><%= message %></span>
        </div>
      <% } %>

      <form id="forgot-form" class="auth-form" action="/admin/forgot-password" method="POST">
        <div class="auth-field">
          <label for="email">Email address</label>
          <div class="auth-input-wrap">
            <i class="fa-regular fa-envelope auth-icon"></i>
            <input class="auth-input" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>
          </div>
        </div>

        <button type="submit" class="auth-submit" id="forgot-submit">
          <span class="spinner" aria-hidden="true"></span>
          <span class="auth-submit-label">Send reset link</span>
        </button>
      </form>

      <p class="auth-footer"><a class="auth-link" href="/admin/login"><i class="fa-solid fa-arrow-left" style="font-style: normal"></i>&nbsp; Back to sign in</a></p>
    </div>
  </main>

  <script>
    document.getElementById("forgot-form").addEventListener("submit", () => {
      const submit = document.getElementById("forgot-submit");
      submit.disabled = true;
      submit.classList.add("is-loading");
      submit.querySelector(".auth-submit-label").textContent = "Sending…";
    });
  </script>
</body>
</html>
