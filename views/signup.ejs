<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create Account</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" type="image/x-icon" href="/logo.png" />
  </head>
  <body>
    <main class="auth-page">
      <div class="auth-card auth-card--wide">
        <div class="auth-brand">
          <a href="/"><img src="/logo.png" alt="Logo" /></a>
          <h1>Create your account</h1>
          <p>Join our community. It only takes a minute.</p>
        </div>

        <div id="signup-error" class="auth-alert auth-alert--error" role="alert" style="display: none">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span id="signup-error-text"></span>
        </div>

        <form
          id="signup-form"
          class="auth-form"
          action="/signup"
          method="post"
          enctype="multipart/form-data"
        >
          <!-- Profile picture -->
          <div class="auth-avatar">
            <div class="auth-avatar-preview" id="avatar-preview">
              <i class="fa-solid fa-user"></i>
            </div>
            <div>
              <label for="file-input" class="auth-file-btn">
                <i class="fa-solid fa-camera"></i>&nbsp; Upload photo
              </label>
              <input
                type="file"
                id="file-input"
                class="auth-file-input"
                name="profile_picture"
                accept="image/png, image/jpeg"
              />
              <p class="auth-hint">Optional. JPG or PNG.</p>
            </div>
          </div>

          <div class="auth-field">
            <label for="username">Full name</label>
            <div class="auth-input-wrap">
              <i class="fa-regular fa-user auth-icon"></i>
              <input class="auth-input" type="text" id="username" name="username" placeholder="John Doe" autocomplete="name" required />
            </div>
          </div>

          <div class="auth-field">
            <label for="email">Email address</label>
            <div class="auth-input-wrap">
              <i class="fa-regular fa-envelope auth-icon"></i>
              <input class="auth-input" type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required />
            </div>
          </div>

          <div class="auth-grid">
            <div class="auth-field">
              <label for="phone">Phone number</label>
              <div class="auth-input-wrap">
                <i class="fa-solid fa-phone auth-icon"></i>
                <input class="auth-input" type="tel" id="phone" name="phone" placeholder="0801 234 5678" autocomplete="tel" required />
              </div>
            </div>

            <div class="auth-field">
              <label for="gender">Gender</label>
              <div class="auth-input-wrap">
                <i class="fa-solid fa-venus-mars auth-icon"></i>
                <select class="auth-input" id="gender" name="gender" required>
                  <option value="" disabled selected>Select</option>
                  <option>Male</option>
                  <option>Female</option>
                  <option>Not Specified</option>
                </select>
                <i class="fa-solid fa-chevron-down auth-chevron"></i>
              </div>
            </div>
          </div>

          <div class="auth-field">
            <label for="dob">Date of birth <span style="font-weight: 400; color: #8a8a8a">(optional)</span></label>
            <div class="auth-input-wrap">
              <i class="fa-regular fa-calendar auth-icon"></i>
              <input class="auth-input" type="date" id="dob" name="dob" />
            </div>
          </div>

          <div class="auth-field">
            <label for="password">Password</label>
            <div class="auth-input-wrap">
              <i class="fa-solid fa-lock auth-icon"></i>
              <input class="auth-input" id="password" type="password" name="password" placeholder="Create a password" autocomplete="new-password" minlength="6" required />
              <button type="button" class="auth-toggle-password" id="togglePassword" aria-label="Show password">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
            <p class="auth-hint">At least 6 characters.</p>
          </div>

          <button type="submit" class="auth-submit" id="signup-submit">
            <span class="spinner" aria-hidden="true"></span>
            <span class="auth-submit-label">Create account</span>
          </button>
          <p class="auth-status" id="signup-status" style="display: none">
            Creating your account and sending a verification code to your email…
          </p>
        </form>

        <p class="auth-footer">Already have an account? <a class="auth-link" href="/admin/login">Sign in</a></p>
      </div>

      <!-- OTP verification modal -->
      <div id="otp-modal" class="modal" style="display: none" role="dialog" aria-modal="true" aria-labelledby="otp-title">
        <div class="modal-content" style="max-width: 440px; text-align: center">
          <span class="close" onclick="closeOtpModal()" aria-label="Close">&times;</span>
          <div class="otp-icon"><i class="fa-regular fa-envelope-open"></i></div>
          <h3 id="otp-title" style="text-align: center; padding-right: 0">Check your email</h3>
          <p style="margin: 0 0 6px">
            We sent a 6-digit code to <strong id="otp-email"></strong>.
          </p>
          <p class="auth-hint" style="margin: 0 0 22px">
            The code expires in 10 minutes. If you can't find it, check your spam folder.
          </p>

          <div id="otp-alert" class="auth-alert" role="alert" style="display: none; text-align: left">
            <i></i>
            <span id="otp-alert-text"></span>
          </div>

          <form id="otp-form" class="auth-form">
            <input
              class="auth-input otp-code-input"
              id="otp-input"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="6"
              pattern="[0-9]{6}"
              placeholder="••••••"
              aria-label="Verification code"
              required
            />
            <button type="submit" class="auth-submit" id="otp-submit" style="margin-top: 16px">
              <span class="spinner" aria-hidden="true"></span>
              <span class="auth-submit-label">Verify email</span>
            </button>
          </form>

          <p class="otp-resend">
            Didn't get a code? <button type="button" id="resend-btn">Resend code</button>
          </p>
          <p class="otp-resend" style="margin-top: 6px">
            <a class="auth-link" href="javascript:void(0);" onclick="closeOtpModal()">Use a different email</a>
          </p>
        </div>
      </div>
    </main>

    <script>
      const signupForm = document.getElementById("signup-form");
      const signupSubmit = document.getElementById("signup-submit");
      const signupStatus = document.getElementById("signup-status");
      const otpModal = document.getElementById("otp-modal");
      const otpForm = document.getElementById("otp-form");
      const otpInput = document.getElementById("otp-input");
      const otpSubmit = document.getElementById("otp-submit");
      const resendBtn = document.getElementById("resend-btn");
      let lastSignupData = null;
      let resendTimer = null;

      function setLoading(button, isLoading, label) {
        button.disabled = isLoading;
        button.classList.toggle("is-loading", isLoading);
        button.querySelector(".auth-submit-label").textContent = label;
      }

      function showSignupError(message) {
        const box = document.getElementById("signup-error");
        document.getElementById("signup-error-text").textContent = message;
        box.style.display = message ? "flex" : "none";
        if (message) box.scrollIntoView({ behavior: "smooth", block: "center" });
      }

      function showOtpAlert(message, type) {
        const box = document.getElementById("otp-alert");
        box.className = "auth-alert auth-alert--" + type;
        box.querySelector("i").className =
          type === "success" ? "fa-solid fa-circle-check" : "fa-solid fa-circle-exclamation";
        document.getElementById("otp-alert-text").textContent = message;
        box.style.display = message ? "flex" : "none";
      }

      // Send the signup details; the server emails the OTP code
      async function sendSignup(formData) {
        const res = await fetch("/signup", { method: "POST", body: formData });
        const text = await res.text();
        if (!res.ok) throw new Error(text || "Something went wrong. Please try again.");
      }

      function startResendCooldown(seconds) {
        clearInterval(resendTimer);
        let remaining = seconds;
        resendBtn.disabled = true;
        resendBtn.textContent = `Resend in ${remaining}s`;
        resendTimer = setInterval(() => {
          remaining -= 1;
          if (remaining <= 0) {
            clearInterval(resendTimer);
            resendBtn.disabled = false;
            resendBtn.textContent = "Resend code";
          } else {
            resendBtn.textContent = `Resend in ${remaining}s`;
          }
        }, 1000);
      }

      function openOtpModal() {
        document.getElementById("otp-email").textContent =
          document.getElementById("email").value;
        showOtpAlert("", "error");
        otpInput.value = "";
        otpModal.style.display = "flex";
        startResendCooldown(30);
        setTimeout(() => otpInput.focus(), 100);
      }

      function closeOtpModal() {
        otpModal.style.display = "none";
        clearInterval(resendTimer);
      }

      signupForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        showSignupError("");
        lastSignupData = new FormData(signupForm);

        setLoading(signupSubmit, true, "Creating account…");
        signupStatus.style.display = "block";

        try {
          await sendSignup(lastSignupData);
          openOtpModal();
        } catch (err) {
          showSignupError(err.message === "Failed to fetch"
            ? "We couldn't reach the server. Check your connection and try again."
            : err.message);
        } finally {
          setLoading(signupSubmit, false, "Create account");
          signupStatus.style.display = "none";
        }
      });

      otpInput.addEventListener("input", () => {
        otpInput.value = otpInput.value.replace(/\D/g, "").slice(0, 6);
      });

      otpForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        showOtpAlert("", "error");
        setLoading(otpSubmit, true, "Verifying…");

        try {
          const res = await fetch("/verify-otp", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email: document.getElementById("email").value,
              otp: otpInput.value,
            }),
          });
          const text = await res.text();

          if (!res.ok) {
            const message = /expired/i.test(text)
              ? "This code has expired. Please request a new one."
              : "That code isn't right. Please check it and try again.";
            showOtpAlert(message, "error");
            setLoading(otpSubmit, false, "Verify email");
            return;
          }

          showOtpAlert("Your email is verified. Taking you to sign in…", "success");
          otpSubmit.querySelector(".auth-submit-label").textContent = "Verified";
          setTimeout(() => {
            window.location.href = "/admin/login";
          }, 1500);
        } catch (err) {
          showOtpAlert("We couldn't reach the server. Please try again.", "error");
          setLoading(otpSubmit, false, "Verify email");
        }
      });

      resendBtn.addEventListener("click", async () => {
        if (!lastSignupData) return;
        resendBtn.disabled = true;
        resendBtn.textContent = "Sending…";
        try {
          await sendSignup(lastSignupData);
          showOtpAlert("A new code has been sent to your email.", "success");
          otpInput.value = "";
          startResendCooldown(30);
        } catch (err) {
          showOtpAlert(err.message, "error");
          resendBtn.disabled = false;
          resendBtn.textContent = "Resend code";
        }
      });

      // Show / hide password
      const passwordInput = document.getElementById("password");
      const togglePassword = document.getElementById("togglePassword");

      togglePassword.addEventListener("click", () => {
        const isHidden = passwordInput.type === "password";
        passwordInput.type = isHidden ? "text" : "password";
        togglePassword.setAttribute("aria-label", isHidden ? "Hide password" : "Show password");
        const icon = togglePassword.querySelector("i");
        icon.classList.toggle("fa-eye");
        icon.classList.toggle("fa-eye-slash");
      });

      // Profile picture preview
      const fileInput = document.getElementById("file-input");
      const avatarPreview = document.getElementById("avatar-preview");

      fileInput.addEventListener("change", function () {
        const file = this.files[0];
        if (!file) {
          avatarPreview.innerHTML = '<i class="fa-solid fa-user"></i>';
          return;
        }
        const reader = new FileReader();
        reader.onload = (e) => {
          avatarPreview.innerHTML = "";
          const img = document.createElement("img");
          img.src = e.target.result;
          img.alt = "Profile picture preview";
          avatarPreview.appendChild(img);
        };
        reader.readAsDataURL(file);
      });
    </script>
  </body>
</html>
