<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  </head>
  <body>
    <%- include('partials/siteHeader', { active: 'videos' }) %>

    <main class="page">
      <a class="page-back" href="/videos"><i class="fa-solid fa-arrow-left"></i> All videos</a>

      <article class="detail-card">
        <p class="eyebrow">Video · <%= new Date(video.created_at3).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) %></p>
        <h1 class="detail-title"><%= video.title %></h1>

        <% if (embedUrl) { %>
          <div class="detail-video">
            <iframe
              src="<%= embedUrl %>"
              title="<%= video.title %>"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        <% } else { %>
          <p class="detail-body">This video link is invalid.</p>
        <% } %>

        <% if (video.description) { %>
          <div class="detail-body"><%= video.description %></div>
        <% } %>

        <div class="detail-actions">
          <button type="button" class="share-btn" onclick="shareLink('/videos/<%= video.id %>', <%= JSON.stringify(video.title) %>)">
            <i class="fa-solid fa-share-nodes"></i> Share this video
          </button>
        </div>
      </article>
    </main>

    <%- include('partials/siteFooter') %>
  </body>
</html>
